{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:static",
  "outputDirectory": "dist/client",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/low-amh-can-you-still-get-pregnant-2",
      "destination": "/ivf-treatment-in-bangalore/",
      "permanent": true
    },
    {
      "source": "/icsi-treatment-for-male-infertility",
      "destination": "/icsi-treatment-in-marathahalli-whitefield-bangalore/",
      "permanent": true
    },
    {
      "source": "/iui-treatment-a-complete-guide",
      "destination": "/intrauterine-insemination-iui-treatment-marathahalli-whitefield-in-bangalore/",
      "permanent": true
    },
    {
      "source": "/category/uncategorized",
      "destination": "/blogs/",
      "permanent": true
    },
    {
      "source": "/author/priyanka",
      "destination": "/blogs/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
