# Neo Fertility Clinic — Apache config for static hosting (Hostinger, GoDaddy, or any
# shared/cPanel host). Ships automatically as part of `npm run build:static`'s output
# (dist/client/) because everything in public/ is copied verbatim into the build.
#
# Upload the *contents* of dist/client/ (not the folder itself) to your hosting account's
# web root (public_html/ on Hostinger and GoDaddy). This file must land in that same root.

RewriteEngine On

# ---------------------------------------------------------------------------
# 1. Canonical host: force HTTPS and the bare apex domain (no www).
#    neofertility.co.in is canonical everywhere else on this site (SITE_URL in
#    src/data/navigation.ts, every canonical tag, sitemap.xml, JSON-LD) — www
#    and plain-http traffic must redirect here, never the reverse.
# ---------------------------------------------------------------------------
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.neofertility\.co\.in$ [NC]
RewriteRule ^ https://neofertility.co.in%{REQUEST_URI} [L,R=301]

# ---------------------------------------------------------------------------
# 2. Legacy WordPress URLs that still hold search rankings. Mirrors
#    LEGACY_REDIRECTS in src/server.ts, which only runs on the SSR/Cloudflare
#    deploy — this is the static-hosting equivalent of the same table. Keep
#    both lists in sync if that map ever changes.
# ---------------------------------------------------------------------------
RewriteRule ^low-amh-can-you-still-get-pregnant-2/?$ /ivf-treatment-in-bangalore/ [L,R=301]
RewriteRule ^icsi-treatment-for-male-infertility/?$ /icsi-treatment-in-marathahalli-whitefield-bangalore/ [L,R=301]
RewriteRule ^iui-treatment-a-complete-guide/?$ /intrauterine-insemination-iui-treatment-marathahalli-whitefield-in-bangalore/ [L,R=301]
RewriteRule ^category/uncategorized/?$ /blogs/ [L,R=301]
RewriteRule ^author/priyanka/?$ /blogs/ [L,R=301]

# ---------------------------------------------------------------------------
# 3. Routing. Every real page on this site was rendered to an actual file at
#    build time, but they're kept out of the way in pages/<route>/index.html
#    (see scripts/organize-static-build.mjs) rather than cluttering the web
#    root — the two rules below make that invisible to visitors and search
#    engines: the URL bar and canonical tags still show /contact/, never
#    /pages/contact/.
#
#    a) A request with no trailing slash (e.g. /contact) gets a real 301 to
#       the slashed form, same as Apache's own mod_dir would do for a plain
#       directory — needed explicitly here because /contact is no longer a
#       directory at the root.
#    b) A request that already ends in "/" and has a matching file under
#       pages/ is served from there internally, with no visible redirect.
#
#    A URL that matches neither — a typo, a route added since the last
#    build, or truly bad — falls through to ErrorDocument 404 below. Hand it
#    to the client app's own "Page not found" screen, but keep the real 404
#    status so it's never indexed as a working page.
# ---------------------------------------------------------------------------
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{REQUEST_URI} !\.\w+$
RewriteCond %{DOCUMENT_ROOT}/pages%{REQUEST_URI}/index.html -f
RewriteRule ^(.*[^/])$ /$1/ [L,R=301]

RewriteCond %{DOCUMENT_ROOT}/pages%{REQUEST_URI}index.html -f
RewriteRule ^(.*)$ /pages/$1index.html [L]

ErrorDocument 404 /index.html

DirectoryIndex index.html
Options -MultiViews -Indexes

# ---------------------------------------------------------------------------
# 4. Compression
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml
  AddOutputFilterByType DEFLATE application/javascript application/json image/svg+xml
</IfModule>

# ---------------------------------------------------------------------------
# 5. Caching. Built asset filenames are content-hashed (styles-B_pPhz2C.css,
#    index-DszeSF9R.js, ...), so they're safe to cache forever — a new deploy
#    ships new filenames. HTML must always be revalidated, so a fresh deploy
#    is seen on the next visit instead of from a stale cached page.
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/plain "access plus 1 hour"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType video/webm "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js|mjs|woff2?|jpe?g|png|webp|svg|mp4|webm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ---------------------------------------------------------------------------
# 6. MIME types some default Apache configs (older Hostinger/GoDaddy images)
#    still get wrong.
# ---------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType image/webp .webp
  AddType video/webm .webm
  AddType font/woff2 .woff2
  AddType application/xml .xml
</IfModule>
